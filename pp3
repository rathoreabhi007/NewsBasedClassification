# ---------------------------------------------------------------------------
# 5. Runner
# ---------------------------------------------------------------------------
def run_financial_profiler(
    inputs: Union[str, List[str]],
    json_path: str = "master_financial_profile.json",
    html_path: str = "financial_analytics_studio.html",
    skip_rows: int = 0,
):
    """
    skip_rows: number of leading rows to skip in each CSV/Excel source before
    the real header row (e.g. report banners/metadata rows some exports
    prepend). Applied uniformly to every CSV/TXT/TSV/DAT and Excel file in
    this run; has no effect on Parquet sources.
    """
    file_list = []

    if isinstance(inputs, str):
        if os.path.isdir(inputs):
            for root, _, files in os.walk(inputs):
                for f in files:
                    if not f.startswith("~") and not f.startswith("."):
                        ext = os.path.splitext(f)[-1].lower()
                        if ext in [".csv", ".tsv", ".parquet", ".pq", ".xlsx", ".xls", ".dat", ".txt"]:
                            file_list.append(os.path.join(root, f))
        elif os.path.isfile(inputs):
            file_list.append(inputs)
        else:
            file_list = glob.glob(inputs)
    elif isinstance(inputs, list):
        file_list = inputs

    print(f"=== Running Profiler on {len(file_list)} File(s) ===")

    profiler = GenericFinancialProfiler(chunksize=50000, skip_rows=skip_rows)
    all_profiles = []
    for filepath in file_list:
        print(f"Ingesting: {os.path.basename(filepath)}...")
        # FIX: profile_file now returns a list (1 entry normally, 1 per
        # sheet for multi-sheet Excel workbooks), so extend rather than
        # append.
        profiles = profiler.profile_file(filepath)
        for p in profiles:
            # FIX (silent failure visibility): a caught ingestion exception
            # (e.g. OOM on a huge high-cardinality file, bad encoding, etc.)
            # previously only showed up buried in the file's risk_alerts
            # inside the JSON/HTML. Printing it immediately means a "blank"
            # or empty-looking dashboard has an obvious cause in the console
            # instead of requiring a dig through the output files.
            if p["file_metadata"]["status"] == "ERROR":
                print(f"  !! ERROR profiling {p['file_metadata']['file_name']}: "
                      f"{p['file_metadata'].get('error_message')}")
        all_profiles.extend(profiles)

    FinancialDashboardGenerator.generate_dashboard(all_profiles, json_path, html_path)
    print("=== Profiling Complete ===")



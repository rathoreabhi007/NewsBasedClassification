        .progress-bar-bg {{ background: #0b132b; height: 8px; border-radius: 4px; overflow: hidden; width: 100%; border: 1px solid var(--border-color); }}
        .progress-bar-fill {{ background: var(--accent-blue); height: 100%; }}

        .empty-state {{ text-align: center; color: var(--text-muted); margin-top: 100px; font-size: 15px; }}
    </style>
</head>
<body>
    <div class="top-navbar">
        <h1>Data Quality & Forensic Studio</h1>
        <div class="meta" id="headerMeta">Master Profile Dashboard</div>
    </div>

    <div class="app-container">
        <!-- Panel 1: File List -->
        <div class="panel-files">
            <div class="panel-header">Audited Datasets</div>
            <input type="text" id="fileSearch" class="search-input" placeholder="Search files..." oninput="renderFileList()">
            <div class="file-list" id="fileList"></div>
        </div>

        <!-- Panel 2: Column Selection -->
        <div class="panel-columns">
            <div class="panel-header" id="colPanelHeader">Columns</div>
            <input type="text" id="colSearch" class="search-input" placeholder="Filter columns..." oninput="renderColumnList()">
            <div class="column-list" id="columnList"></div>
        </div>

        <!-- Panel 3: In-Depth Inspector -->
        <div class="panel-inspector" id="inspectorPanel">
            <div class="empty-state">Select a dataset and column to inspect temporal and statistical metrics.</div>
        </div>
    </div>

    <script>
        const MASTER_DATA = {json_data_str};
        let activeFileIdx = null;
        let activeColIdx = null;
        let activeTimeGrain = 'monthly'; // Options: yearly, halfyearly, quarterly, monthly

        const ROLE_COLORS = {{
            "Entity Identifier": "#2563eb",
            "Regulatory Code": "#7c3aed",
            "Monetary Amount": "#059669",
            "Rate / Percentage": "#10b981",
            "Categorical / Enum": "#d97706",
            "Timestamp / Date": "#db2777",
            "Flag / Indicator": "#0891b2",
            "Numeric Measure": "#6366f1",
            "Free Text / Narrative": "#64748b"
        }};

        function init() {{
            document.getElementById('headerMeta').innerText = `Generated: ${{MASTER_DATA.generated_at}} | Total Files: ${{MASTER_DATA.total_files}}`;
            renderFileList();
            if (MASTER_DATA.files.length > 0) {{
                selectFile(0);
            }}
        }}

        function renderFileList() {{
            const query = document.getElementById('fileSearch').value.toLowerCase();
            const listEl = document.getElementById('fileList');
            listEl.innerHTML = '';

            MASTER_DATA.files.forEach((f, idx) => {{
                const meta = f.file_metadata;
                if (meta.file_name.toLowerCase().includes(query)) {{
                    const item = document.createElement('div');
                    item.className = `file-item ${{activeFileIdx === idx ? 'active' : ''}}`;
                    item.onclick = () => selectFile(idx);
                    item.innerHTML = `
                        <div class="file-item-name">${{meta.file_name}}</div>
                        <div class="file-item-sub">
                            <span>${{meta.total_rows.toLocaleString()}} rows</span>
                            <span style="font-weight:bold; color:${{f.quality_score > 80 ? '#34d399' : '#f87171'}}">${{f.quality_score}}% Health</span>
                        </div>
                    `;
                    listEl.appendChild(item);
                }}
            }});
        }}

        function selectFile(idx) {{
            activeFileIdx = idx;
            activeColIdx = null;
            renderFileList();

            const fileObj = MASTER_DATA.files[idx];
            document.getElementById('colPanelHeader').innerText = `Columns (${{fileObj.columns.length}})`;
            renderColumnList();

            if (fileObj.columns.length > 0) {{
                selectColumn(0);
            }} else {{
                renderFileOverviewOnly();
            }}
        }}

        function renderColumnList() {{
            if (activeFileIdx === null) return;
            const query = document.getElementById('colSearch').value.toLowerCase();
            const columns = MASTER_DATA.files[activeFileIdx].columns;
            const listEl = document.getElementById('columnList');
            listEl.innerHTML = '';

            columns.forEach((c, idx) => {{
                if (c.field_name.toLowerCase().includes(query) || c.semantic_role.role.toLowerCase().includes(query)) {{
                    const role = c.semantic_role.role;
                    const color = ROLE_COLORS[role] || '#64748b';
                    const item = document.createElement('div');
                    item.className = `column-item ${{activeColIdx === idx ? 'active' : ''}}`;
                    item.onclick = () => selectColumn(idx);
                    item.innerHTML = `
                        <div>
                            <div class="col-title">${{c.field_name}}</div>
                            <div style="font-size:11px; color:#9ca3af;">${{c.detected_dtype}}</div>
                        </div>
                        <span class="badge" style="background:${{color}}">${{role}}</span>
                    `;
                    listEl.appendChild(item);
                }}
            }});
        }}

        function selectColumn(idx) {{
            activeColIdx = idx;
            renderColumnList();
            renderInspector();
        }}

        function setTimeGrain(grain) {{
            activeTimeGrain = grain;
            renderInspector();
        }}

        function renderFileOverviewOnly() {{
            const fileObj = MASTER_DATA.files[activeFileIdx];
            const meta = fileObj.file_metadata;
            let bodyHtml = `
                <h2 style="font-size:24px; color:#fff; margin-bottom:16px;">${{meta.file_name}} Overview</h2>
                <div class="stat-card-grid">
                    <div class="card"><div class="lbl">Total Rows</div><div class="val">${{meta.total_rows.toLocaleString()}}</div></div>
                    <div class="card"><div class="lbl">Duplicate Rows</div><div class="val" style="color:${{meta.duplicate_rows_count > 0 ? '#f87171' : '#fff'}}">${{meta.duplicate_rows_count.toLocaleString()}} (${{meta.duplicate_rows_pct}}%)</div></div>
                    <div class="card"><div class="lbl">Quality Score</div><div class="val" style="color:${{fileObj.quality_score > 80 ? '#34d399' : '#f87171'}}">${{fileObj.quality_score}}%</div></div>
                </div>
            `;
            if (meta.status === 'ERROR') {{
                bodyHtml += `<div class="card" style="border-left:4px solid #ef4444; margin-top:16px;">
                    <div class="lbl">Ingestion Error</div>
                    <div style="color:#fca5a5; font-size:13px;">${{meta.error_message || 'Unknown error'}}</div>
                </div>`;
            }}
            document.getElementById('inspectorPanel').innerHTML = bodyHtml;
        }}

        function renderInspector() {{
            if (activeFileIdx === null || activeColIdx === null) return;
            const fileObj = MASTER_DATA.files[activeFileIdx];
            const meta = fileObj.file_metadata;
            const col = fileObj.columns[activeColIdx];
            const inspector = document.getElementById('inspectorPanel');
            const role = col.semantic_role;
            const roleColor = ROLE_COLORS[role.role] || '#64748b';

            let bodyHtml = `
                <!-- File Overhead Metadata Summary -->
                <div style="background:#1c2541; padding:12px 16px; border-radius:8px; margin-bottom:20px; border:1px solid #3a506b; display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <span style="font-size:12px; color:#94a3b8;">ACTIVE FILE:</span>
                        <strong style="color:#fff; font-size:14px; margin-left:6px;">${{meta.file_name}}</strong>
                    </div>
                    <div style="font-size:12px;">
                        Exact Duplicates: <b style="color:${{meta.duplicate_rows_count > 0 ? '#f87171' : '#34d399'}}">${{meta.duplicate_rows_count.toLocaleString()}} (${{meta.duplicate_rows_pct}}%)</b>
                    </div>
                </div>

                <!-- Column Header -->
                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
                    <div>
                        <h2 style="font-size:24px; color:#fff;">${{col.field_name}}</h2>
                        <div style="font-size:13px; color:#94a3b8; margin-top:4px;">
                            Dtype: <b>${{col.detected_dtype}}</b> | Semantic Subtype: <b>${{role.subtype}}</b>
                        </div>
                    </div>
                    <span class="badge" style="background:${{roleColor}}; font-size:12px; padding:6px 12px;">${{role.role}}</span>
                </div>

                <div class="card" style="margin-bottom:20px; border-left:4px solid ${{roleColor}};">
                    <div class="lbl">Semantic Decision Reasoning</div>
                    <div style="font-size:13px; color:#cbd5e1;">${{role.reasoning}} (Confidence: ${{(role.confidence * 100).toFixed(0)}}%)</div>
                </div>

                <div class="stat-card-grid">
                    <div class="card">
                        <div class="lbl">Populated Rate</div>
                        <div class="val">${{col.populated_pct}}%</div>
                        <div style="font-size:11px; color:#94a3b8; margin-top:4px;">${{col.populated_count.toLocaleString()}} / ${{col.total_rows.toLocaleString()}}</div>
                    </div>
                    <div class="card">
                        <div class="lbl">Null / Empty Count</div>
                        <div class="val" style="color:${{col.null_count > 0 ? '#f87171' : '#fff'}}">${{col.null_count.toLocaleString()}}</div>
                        <div style="font-size:11px; color:#94a3b8; margin-top:4px;">${{col.null_pct}}% missing</div>
                    </div>
                    <div class="card">
                        <div class="lbl">Distinct Values</div>
                        <div class="val">${{col.distinct_count_is_lower_bound ? '&ge;' : ''}}${{col.distinct_count.toLocaleString()}}</div>
                        <div style="font-size:11px; color:#94a3b8; margin-top:4px;">Card. Ratio: ${{col.cardinality_ratio}}</div>
                    </div>
                    <div class="card">
                        <div class="lbl">Uniqueness Flag</div>
                        <div class="val" style="font-size:16px;">${{col.is_unique ? 'UNIQUE KEY' : (col.is_constant ? 'CONSTANT' : 'RECURRING')}}</div>
                    </div>
                </div>
            `;

            // Cross-Column Reconciliation Checks
            if (fileObj.cross_column_reconciliation && fileObj.cross_column_reconciliation.length > 0) {{
                bodyHtml += `
                    <div class="section-title">Cross-Column Reconciliation Integrity</div>
                    <table>
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Check Description</th>
                                <th>Tested Records</th>
                                <th>Violations</th>
                                <th>Violation Rate</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${{fileObj.cross_column_reconciliation.map(r => `
                                <tr>
                                    <td><b>${{r.check_category}}</b></td>
                                    <td>${{r.check_name}}</td>
                                    <td>${{r.tested_records.toLocaleString()}}</td>
                                    <td style="color:${{r.violations_count > 0 ? '#f87171' : '#fff'}}">${{r.violations_count.toLocaleString()}}</td>
                                    <td>${{r.violation_pct}}%</td>
                                    <td><span class="badge" style="background:${{r.status === 'PASSED' ? '#059669' : '#dc2626'}}">${{r.status}}</span></td>
                                </tr>
                            `).join('')}}
                        </tbody>
                    </table>
                `;
            }}

            // Temporal Multi-Grain Analysis
            if (col.temporal_stats) {{
                const t = col.temporal_stats;
                let grainDist = {{}};
                if (activeTimeGrain === 'yearly') grainDist = t.yearly_distribution || {{}};
                else if (activeTimeGrain === 'halfyearly') grainDist = t.halfyearly_distribution || {{}};
                else if (activeTimeGrain === 'quarterly') grainDist = t.quarterly_distribution || {{}};
                else grainDist = t.monthly_distribution || {{}};

                const totalPeriodCount = Object.values(grainDist).reduce((a, b) => a + b, 0);

                bodyHtml += `
                    <div class="section-title">
                        <span>Temporal Profile & Age Slicing</span>
                        <div class="grain-controls">
                            <button class="grain-btn ${{activeTimeGrain === 'yearly' ? 'active' : ''}}" onclick="setTimeGrain('yearly')">Yearly</button>
                            <button class="grain-btn ${{activeTimeGrain === 'halfyearly' ? 'active' : ''}}" onclick="setTimeGrain('halfyearly')">Half-Yearly</button>
                            <button class="grain-btn ${{activeTimeGrain === 'quarterly' ? 'active' : ''}}" onclick="setTimeGrain('quarterly')">Quarterly</button>
                            <button class="grain-btn ${{activeTimeGrain === 'monthly' ? 'active' : ''}}" onclick="setTimeGrain('monthly')">Monthly</button>
                        </div>
                    </div>

                    <div class="stat-card-grid">
                        <div class="card"><div class="lbl">Min Date</div><div class="val" style="font-size:16px;">${{t.min_date.substring(0,19)}}</div></div>
                        <div class="card"><div class="lbl">Max Date</div><div class="val" style="font-size:16px;">${{t.max_date.substring(0,19)}}</div></div>
                        <div class="card"><div class="lbl">Time Span</div><div class="val">${{t.span_days}} Days</div></div>
                        <div class="card"><div class="lbl">Future Dated Count</div><div class="val">${{t.future_dated_count}}</div></div>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th>Period (${{activeTimeGrain.toUpperCase()}})</th>
                                <th>Record Volume</th>
                                <th>Share (%)</th>
                                <th style="width:40%;">Volume Spectrum</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${{Object.entries(grainDist).map(([period, cnt]) => {{
                                const pct = totalPeriodCount > 0 ? ((cnt / totalPeriodCount) * 100).toFixed(2) : 0;
                                return `
                                    <tr>
                                        <td><b>${{period}}</b></td>
                                        <td>${{cnt.toLocaleString()}}</td>
                                        <td>${{pct}}%</td>
                                        <td>
                                            <div class="progress-bar-bg">
                                                <div class="progress-bar-fill" style="width:${{pct}}%; background:${{roleColor}};"></div>
                                            </div>
                                        </td>
                                    </tr>
                                `;
                            }}).join('')}}
                        </tbody>
                    </table>
                `;
            }}

            // Numeric Moments
            if (col.numeric_stats) {{
                const num = col.numeric_stats;
                const p = num.percentiles;
                bodyHtml += `
                    <div class="section-title">Numeric Distribution & Moments</div>
                    <div class="stat-card-grid">
                        <div class="card"><div class="lbl">Min</div><div class="val">${{num.min.toLocaleString()}}</div></div>
                        <div class="card"><div class="lbl">Max</div><div class="val">${{num.max.toLocaleString()}}</div></div>
                        <div class="card"><div class="lbl">Mean</div><div class="val">${{num.mean.toLocaleString()}}</div></div>
                        <div class="card"><div class="lbl">Std Dev</div><div class="val">±${{num.std_dev.toLocaleString()}}</div></div>
                        <div class="card"><div class="lbl">Skewness</div><div class="val">${{num.skewness}}</div></div>

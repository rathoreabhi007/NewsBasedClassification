class FinancialDashboardGenerator:
    @classmethod
    def generate_dashboard(cls, profiles: List[Dict[str, Any]], json_out_path: str, html_out_path: str):
        master_report = {
            "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "total_files": len(profiles),
            "files": profiles
        }
        with open(json_out_path, "w", encoding="utf-8") as f:
            json.dump(master_report, f, indent=2, default=str)
        print(f"-> Unified Master JSON saved: {json_out_path}")

        # FIX (blank-dashboard bug): the master report is embedded verbatim
        # inside a <script> tag. If ANY string value anywhere in the data
        # (a free-text field, a non-conforming sample, a filename) happens
        # to contain the literal substring "</script", the browser's HTML
        # parser closes the script tag right there -- before the rest of
        # the JSON and all of the dashboard's own JS. Everything after that
        # point is dropped, `init()` never runs, and the page renders as
        # blank/empty even though the JSON file on disk is completely
        # correct. Escaping "</" as "<\/" (a no-op inside a JS string/JSON
        # value, but no longer matches the closing-tag sequence) prevents
        # this without changing the parsed data at all. `default=str` is a
        # defensive catch-all for any stray non-JSON-native type (e.g. a
        # pandas/numpy scalar that slipped through) so one bad value can't
        # throw and abort dashboard generation entirely.
        json_data_str = json.dumps(master_report, default=str).replace("</", "<\\/")
        html_content = f"""<!DOCTYPE html>
<html lang="en">

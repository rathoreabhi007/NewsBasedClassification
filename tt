# =============================================================================
# FIRDS FCA — integrated enrich + delta CSVs + 180-day terminations.
# Run: python main.py
# Inputs: FIRDS_FILE_PATH (XML). Outputs: FIRDS_OUTPUT_PATH (all CSVs).
# =============================================================================

import glob
import os
import warnings
from datetime import datetime, timedelta
from shutil import copyfile

import pandas as pd
from lxml import etree as ET

warnings.filterwarnings("ignore")

# Input: incoming XML (and optional legacy enrich seed if not yet in output).
FIRDS_FILE_PATH = "/REGQA/Source Data/Incoming Data/FIRDS/FCA/"
# Output: all generated CSVs (enrich, FCA_delta_*, terminations).
FIRDS_OUTPUT_PATH = "/REGQA/Source Data/Outgoing Data/FIRDS/FCA/"
TERMINATION_FILE = "FIRDS_180DAY_TERMINATIONS_FCA.csv"

CSV_HEADER = (
    "ISIN,Venue,ISSR,con_key,Date of Admission to Trading or Date of First Trade,"
    "CrDate,Flag,Publication Date,Termination Date,Instrument Full Name,"
    "Instrument Classification,Commodities or emission allowance derivative indicator,"
    "Expiry Date\n"
)

FLAG_ERROR_NODE1 = "FULL FILE or ERROR IN ELEMENT"
FLAG_ERROR_NODE2 = "FULL FILE OR ERROR IN ELEMENT"


def _input_dir():
    return FIRDS_FILE_PATH.rstrip(os.sep) + os.sep


def _output_dir():
    return FIRDS_OUTPUT_PATH.rstrip(os.sep)


def _ensure_output_dir():
    os.makedirs(_output_dir(), exist_ok=True)


def _prior_enrich_path(t_2_date):
    """Previous enrich CSV: prefer output dir, fall back to input (legacy layout)."""
    name = "FIRDS_FCA_{}.csv".format(t_2_date)
    out_path = os.path.join(_output_dir(), name)
    if os.path.isfile(out_path):
        return out_path
    in_path = os.path.join(_input_dir(), name)
    if os.path.isfile(in_path):
        return in_path
    raise FileNotFoundError(
        "Prior enrich file not found in output or input: {}".format(name)
    )


def count_rows(csv_file):
    """Counts how many lines there are in the file provided."""
    line_count = 0
    with open(csv_file, "r") as f:
        for line_count, _ in enumerate(f):
            pass
    return line_count


def _expiry_from_node(node):
    el = node.find(".//{*}DerivInstrmAttrbts/{*}XpryDt")
    if el is not None and el.text:
        return el.text
    el = node.find(".//{*}DerivInstrmAttrbts/{*}ExpiryDt")
    if el is not None and el.text:
        return el.text
    return "NA"


def _mod_flag_from_node(node, flag_error_text):
    try:
        node.find(".//{*}ModfdRcrd").text
        return "M"
    except AttributeError:
        try:
            node.find(".//{*}NewRcrd").text
            return "N"
        except AttributeError:
            try:
                node.find(".//{*}TermntdRcrd").text
                return "D"
            except AttributeError:
                return flag_error_text


def _instrument_row_strings(node, cr_date, flag_error_text):
    isin = node.find(".//{*}FinInstrmGnlAttrbts/{*}Id").text
    expiry_date = _expiry_from_node(node)
    try:
        comm_flag = node.find(".//{*}FinInstrmGnlAttrbts/{*}CmmdtyDerivInd").text
    except AttributeError:
        comm_flag = "NA"
    try:
        issr = node.find(".//{*}Issr").text
    except AttributeError:
        issr = "NA"

    venue = node.find(".//{*}TradgVnRltdAttrbts/{*}Id").text
    try:
        first_trade_date = node.find(".//{*}TradgVnRltdAttrbts/{*}FrstTradDt").text
    except AttributeError:
        first_trade_date = "NA"
    try:
        pub_dt = node.find(".//{*}PblctnPrd//{*}FrDt").text
    except AttributeError:
        pub_dt = "NA"
    try:
        term_dt = node.find(".//{*}TradgVnRltdAttrbts//{*}TermntnDt").text
    except AttributeError:
        term_dt = "NA"

    mod_flag = _mod_flag_from_node(node, flag_error_text)

    try:
        ins_full_name = node.find(".//{*}FullNm").text.encode("utf-8").replace(",", "")
    except AttributeError:
        ins_full_name = "NA"

    try:
        ins_classification = node.find(".//{*}ClssfctnTp").text
    except AttributeError:
        ins_classification = "NA"

    line = (
        isin
        + ","
        + venue
        + ","
        + issr
        + ","
        + isin
        + "_"
        + venue
        + "_"
        + first_trade_date
        + ","
        + first_trade_date
        + ","
        + cr_date
        + ","
        + mod_flag
        + ","
        + pub_dt
        + ","
        + term_dt
        + ","
        + ins_full_name
        + ","
        + ins_classification
        + ","
        + comm_flag
        + ","
        + expiry_date
        + "\n"
    )
    return line


def parse_xml_file_to_lines(xml_path, flag_error_text):
    """Parse one FIRDS XML file into CSV line strings (no header)."""
    lines = []
    with open(xml_path) as f:
        xml = ET.parse(f)
    cr_date = ""
    hdr_nodes = xml.findall(".//{*}Hdr/{*}AppHdr")
    for hdr_node in hdr_nodes:
        cre = hdr_node.find(".//{*}CreDt")
        if cre is not None and cre.text:
            cr_date = cre.text

    instrument_nodes = xml.findall(".//{*}RefData")
    if not instrument_nodes:
        instrument_nodes = xml.findall(".//{*}FinInstrm")

    for node in instrument_nodes:
        lines.append(_instrument_row_strings(node, cr_date, flag_error_text))
    return lines


def parse_and_write_to_csv_combined(input_file_list, file_location, flag_error_text=FLAG_ERROR_NODE1):
    """Node 1 style: all XML inputs appended into one CSV path."""
    out_file = open(file_location, "w")
    lines_before_writing = count_rows(file_location)
    if lines_before_writing <= 1:
        out_file.write(CSV_HEADER)
    for file_path in input_file_list:
        for line in parse_xml_file_to_lines(file_path, flag_error_text):
            out_file.write(line)
    lines_written = count_rows(file_location) - lines_before_writing
    out_file.close()
    return lines_written


def parse_and_write_to_csv_per_xml(input_file_list, file_location, flag_error_text=FLAG_ERROR_NODE2):
    """Node 2 style: one FCA_delta_{n}.csv per input XML."""
    counter = 1
    total_written = 0
    for file_path in input_file_list:
        full_file_location = os.path.join(
            file_location, "FCA_delta_{}.csv".format(counter)
        )
        out_file = open(full_file_location, "w")
        lines_before_writing = count_rows(full_file_location)
        if lines_before_writing <= 1:
            out_file.write(CSV_HEADER)
        for line in parse_xml_file_to_lines(file_path, flag_error_text):
            out_file.write(line)
        total_written += count_rows(full_file_location) - lines_before_writing
        out_file.close()
        counter += 1
    return total_written


def get_file_paths(fldr, dt, format_ext):
    d_lst = []
    f_lst = []
    for file_name in os.listdir(fldr):
        if file_name.find(dt) > -1:
            if file_name.lower().find(format_ext.lower()) > -1:
                if file_name.lower().find("dltins") > -1:
                    d_lst.append(fldr + file_name)
                if file_name.lower().find("fulins") > -1:
                    f_lst.append(fldr + file_name)
    return d_lst, f_lst


def enrich_file(enrichfile, deltafile):
    full = pd.read_csv(enrichfile)
    delta = pd.read_csv(deltafile)

    temp = pd.merge(full, delta[(delta.Flag == "D")], on="con_key", how="left")

    temp_not_d = temp[(temp.Flag_y != "D")]
    temp_not_d = temp_not_d[
        [
            "ISIN_x",
            "Venue_x",
            "ISSR_x",
            "con_key",
            "Date of Admission to Trading or Date of First Trade_x",
            "CrDate_x",
            "Flag_x",
            "Publication Date_x",
            "Termination Date_x",
            "Instrument Full Name_x",
            "Instrument Classification_x",
            "Commodities or emission allowance derivative indicator_x",
            "Expiry Date_x",
        ]
    ]
    temp_not_d.columns = [
        "ISIN",
        "Venue",
        "ISSR",
        "con_key",
        "Date of Admission to Trading or Date of First Trade",
        "CrDate",
        "Flag",
        "Publication Date",
        "Termination Date",
        "Instrument Full Name",
        "Instrument Classification",
        "Commodities or emission allowance derivative indicator",
        "Expiry Date",
    ]

    temp_n = delta[(delta.Flag == "N")]

    temp_d = temp[(temp.Flag_y == "D")]
    temp_d = temp_d[
        [
            "ISIN_y",
            "Venue_y",
            "ISSR_y",
            "con_key",
            "Date of Admission to Trading or Date of First Trade_y",
            "CrDate_y",
            "Flag_y",
            "Publication Date_y",
            "Termination Date_y",
            "Instrument Full Name_y",
            "Instrument Classification_y",
            "Commodities or emission allowance derivative indicator_y",
            "Expiry Date_y",
        ]
    ]
    temp_d.columns = [
        "ISIN",
        "Venue",
        "ISSR",
        "con_key",
        "Date of Admission to Trading or Date of First Trade",
        "CrDate",
        "Flag",
        "Publication Date",
        "Termination Date",
        "Instrument Full Name",
        "Instrument Classification",
        "Commodities or emission allowance derivative indicator",
        "Expiry Date",
    ]

    final = pd.concat([temp_not_d, temp_n, temp_d])
    final = final[final["Flag"] != "D"]
    final.to_csv(enrichfile, encoding="utf-8", index=False)


def compute_node1_schedule(run_date):
    """Node 1: day_hist, t_1/t_2 dates, and calendar days to process (in order)."""
    day = run_date.weekday()
    day_hist = 1
    t_2_hist = 2

    if (day - day_hist) < 0:
        day_hist = day_hist + 2
        t_2_hist = t_2_hist + 2
    elif (day - day_hist) == 0:
        t_2_hist = t_2_hist + 2

    t_1_date = run_date - timedelta(days=day_hist)
    t_2_date = run_date - timedelta(days=t_2_hist)

    loop_date = t_1_date
    loop_dates = []
    for _ in range(day_hist):
        loop_dates.append(loop_date)
        loop_date += timedelta(days=1)

    return day_hist, t_1_date, t_2_date, loop_dates


def get_file_dates(run_date):
    """Node 2: YYYYMMDD strings for delta XML filenames."""
    day_of_week = run_date.weekday()
    if day_of_week == 0:
        dates = [run_date - timedelta(days=i) for i in range(1, 4)]
    else:
        dates = [run_date - timedelta(days=1)]
    return [d.strftime("%Y%m%d") for d in dates]


def get_delta_files(firds_dir, valid_date_strings):
    xml_files = [
        os.path.join(firds_dir, file)
        for file in os.listdir(firds_dir)
        if file.endswith(".xml")
        and "DLTINS" in file.upper()
        and any(dt in file for dt in valid_date_strings)
    ]
    return xml_files


def clear_fca_delta_outputs(file_location):
    """Remove prior FCA_delta_*.csv so termination logic does not read stale files."""
    for path in glob.glob(os.path.join(file_location, "FCA_delta*.csv")):
        os.remove(path)


def process_delta_and_terminations(
    firds_dir, file_location, termination_file, run_date, raise_on_no_delta=False
):
    """
    Node 2 outputs. If no delta XML matches: skip by default so Node 1 enrich can still
    run (e.g. full-file-only day). Set raise_on_no_delta=True to match legacy Node 2.
    """
    matching_files = get_delta_files(firds_dir, get_file_dates(run_date))
    if not matching_files:
        if raise_on_no_delta:
            raise ValueError("no files")
        return
    clear_fca_delta_outputs(file_location)
    parse_and_write_to_csv_per_xml(matching_files, file_location)
    firds_termination_file(file_location, termination_file, run_date)


def firds_termination_file(file_location, termination_file, run_date):
    pattern = os.path.join(file_location, "FCA_delta*.csv")
    delta_files = glob.glob(pattern)
    if not delta_files:
        return

    all_data = pd.concat([pd.read_csv(file) for file in delta_files])

    all_data["Termination Date"] = pd.to_datetime(
        all_data["Termination Date"], errors="coerce"
    ).dt.tz_localize(None)

    date = run_date

    cond1 = all_data["Termination Date"] < date
    cond2 = all_data["Termination Date"].isna() & (all_data["Flag"] == "D")
    df_latest_filtered = all_data[cond1 | cond2]

    termination_path = os.path.join(file_location, termination_file)

    if os.path.exists(termination_path):
        df_termination = pd.read_csv(termination_path)
    else:
        df_termination = pd.DataFrame()

    df_updated = pd.concat([df_termination, df_latest_filtered], ignore_index=True)
    df_updated["Termination Date"] = pd.to_datetime(
        df_updated["Termination Date"], errors="coerce"
    ).dt.strftime("%Y-%m-%d")
    df_updated["Termination Date"] = pd.to_datetime(
        df_updated["Termination Date"], errors="coerce"
    ).dt.date

    df_updated["Append_date"] = (date - df_updated["Termination Date"]).dt.days
    df_final = df_updated[df_updated["Append_date"] <= 180]
    df_final.to_csv(termination_path, index=False)


def run_enrich_pipeline(input_dir, output_dir, run_date):
    _, t_1_date, t_2_date, loop_dates = compute_node1_schedule(run_date)

    enrich_file_path = os.path.join(output_dir, "FIRDS_FCA_{}.csv".format(t_1_date))
    pre_enrich_file_path = _prior_enrich_path(t_2_date)

    copyfile(pre_enrich_file_path, enrich_file_path)

    for date in loop_dates:
        d_files, f_files = get_file_paths(
            input_dir, str(date.strftime("%Y%m%d")), "xml"
        )

        f_flag = 0
        if f_files:
            op_file = os.path.join(output_dir, "full_{}.csv".format(date))
            parse_and_write_to_csv_combined(f_files, op_file)
            copyfile(op_file, enrich_file_path)
            f_flag = 1

        if d_files and f_flag == 0:
            op_file = os.path.join(output_dir, "delta_{}.csv".format(date))
            parse_and_write_to_csv_combined(d_files, op_file)
            enrich_file(enrich_file_path, op_file)

    l1 = []
    enrich_glob = os.path.join(output_dir, "FIRDS_FCA_*.csv")
    for file in glob.glob(enrich_glob):
        l1.append([file, file[-14:][:10]])
    df = pd.DataFrame(l1, columns=["FileName", "FileDate"])
    df["FileDate"] = pd.to_datetime(df["FileDate"])
    df = df.sort_values("FileDate", ascending=False).reset_index(drop=True)

    if len(df) > 3:
        for i in range(3, len(df)):
            os.remove(df["FileName"].iloc[i])

    for file in glob.glob(os.path.join(output_dir, "delta*.csv")):
        os.remove(file)
    for file in glob.glob(os.path.join(output_dir, "full*.csv")):
        os.remove(file)
    for file in glob.glob(os.path.join(input_dir, "*.xml")):
        os.remove(file)


def run_pipeline(raise_on_no_delta=False):
    """
    Full integrated run: Node 2 (delta + terminations) then Node 1 (enrich + cleanup).
    Node 2 must run before XML deletion in Node 1.
    """
    run_date = datetime.today().date()
    _ensure_output_dir()

    input_dir = _input_dir()
    output_dir = _output_dir()
    process_delta_and_terminations(
        input_dir.rstrip(os.sep),
        output_dir,
        TERMINATION_FILE,
        run_date,
        raise_on_no_delta=raise_on_no_delta,
    )
    run_enrich_pipeline(input_dir, output_dir, run_date)


if __name__ == "__main__":
    run_pipeline()
